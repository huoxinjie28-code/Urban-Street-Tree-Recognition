def process_image(filename):
    north_angle = int(filename.split('_')[-2][1:])
    e_img = np.array(Image.open(os.path.join(input_dir, filename)))
    fov_deg = (90, 90)
    v_deg = 0
    out_hw = (512, 512)

    for i, u_deg in enumerate([0, 90, 180, 270]):
        adjusted_u_deg = (u_deg - north_angle) % 360 - 180
        p_img = py360convert.e2p(e_img, fov_deg, adjusted_u_deg, v_deg, out_hw, mode='bilinear')
